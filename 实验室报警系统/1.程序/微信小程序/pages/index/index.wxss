.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(239, 132, 76, 0.20), transparent 32%),
    radial-gradient(circle at top right, rgba(41, 163, 154, 0.18), transparent 28%),
    linear-gradient(180deg, #f4eadf 0%, #f7f4ee 46%, #f3efe8 100%);
  padding-bottom: 56rpx;
}

.top-safe {
  width: 100%;
}

.hero {
  padding: 20rpx 32rpx 28rpx;
}

.hero__content {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero__copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero__eyebrow {
  color: #8d5a44;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.hero__title {
  color: #1e2a2f;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.18;
}

.hero__subtitle {
  color: #58636f;
  font-size: 24rpx;
}

.hero__refresh {
  min-width: 144rpx;
  height: 72rpx;
  margin: 8rpx 0 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #1f8e82;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.hero__status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.hero__status--online {
  background: rgba(34, 160, 111, 0.12);
  color: #1f8e62;
}

.hero__status--offline {
  background: rgba(222, 95, 63, 0.12);
  color: #d55a3f;
}

.dashboard {
  margin: 0 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 22rpx 48rpx rgba(64, 45, 26, 0.08);
  backdrop-filter: blur(10rpx);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.metric-card {
  position: relative;
  overflow: hidden;
  min-height: 228rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.metric-card::after {
  content: '';
  position: absolute;
  right: -32rpx;
  top: -36rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  opacity: 0.14;
}

.metric-card--warm {
  background: linear-gradient(160deg, #fff0dd 0%, #ffe0cb 100%);
}

.metric-card--warm::after {
  background: #ef8752;
}

.metric-card--cool {
  background: linear-gradient(160deg, #e7f8f5 0%, #d2f0ea 100%);
}

.metric-card--cool::after {
  background: #1f8e82;
}

.metric-card--amber {
  background: linear-gradient(160deg, #fff6de 0%, #ffedc1 100%);
}

.metric-card--amber::after {
  background: #e5a53d;
}

.metric-card--danger {
  background: linear-gradient(160deg, #ffe8df 0%, #ffd6ca 100%);
}

.metric-card--danger::after {
  background: #d96045;
}

.metric-card__icon {
  width: 74rpx;
  height: 74rpx;
}

.metric-card__label {
  position: relative;
  color: #5f676f;
  font-size: 28rpx;
  z-index: 1;
}

.metric-card__value {
  position: relative;
  color: #1d2d35;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  z-index: 1;
}

.alarm-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(150deg, #243442 0%, #304b5d 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(36, 52, 66, 0.18);
}

.alarm-card__head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.alarm-card__icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alarm-card__icon {
  width: 68rpx;
  height: 68rpx;
}

.alarm-card__summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.alarm-card__title {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.82);
}

.alarm-card__value {
  font-size: 44rpx;
  font-weight: 700;
}

.alarm-card__hint {
  color: rgba(255, 255, 255, 0.70);
  font-size: 24rpx;
}

.alarm-card__control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.alarm-card__state {
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.alarm-card__state--on {
  background: rgba(241, 111, 77, 0.18);
  color: #ffbfaf;
}

.alarm-card__state--off {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.82);
}

.message {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.message--error {
  background: rgba(224, 88, 63, 0.10);
  color: #c45138;
}

.message--tip {
  background: rgba(31, 142, 130, 0.08);
  color: #2a726b;
}

@media (max-width: 640rpx) {
  .hero__content {
    flex-direction: column;
  }

  .hero__refresh {
    width: 100%;
  }
}
