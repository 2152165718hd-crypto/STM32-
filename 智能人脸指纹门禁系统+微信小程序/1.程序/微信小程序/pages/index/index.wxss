/**index.wxss**/
page {
  background-color: #f4f5f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #333;
}

.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

/* 状态信息区 */
.status-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.status-row:last-child {
  margin-bottom: 0;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 30rpx;
  font-weight: 600;
}

.online {
  color: #07c160;
}

.offline {
  color: #fa5151;
}

.time-val {
  color: #333;
  font-weight: 500;
  font-size: 26rpx;
}

/* 传感器数据网格区 */
.grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.grid-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.grid-item:active {
  transform: scale(0.98);
}

.icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.item-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 15rpx;
}

.item-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #007AFF;
}

.pwd-text {
  letter-spacing: 4rpx;
}

.pwd-hidden {
  color: #999;
}

/* 云端控制区 */
.control-container {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.control-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
  border-left: 8rpx solid #007AFF;
  padding-left: 20rpx;
}

.btn-group {
  display: flex;
  justify-content: space-between;
}

.control-btn {
  width: 46%;
  padding: 30rpx 0;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.1);
}

.btn-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
}

.door-btn {
  background: linear-gradient(135deg, #00C6FF, #0072FF);
}

.pwd-btn {
  background: linear-gradient(135deg, #FF8008, #FFC837);
}

.btn-hover {
  opacity: 0.85;
  transform: translateY(2rpx);
}

/* 密码修改弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.modal-input {
  background: #f4f5f7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-btns {
  display: flex;
  justify-content: space-between;
}

.modal-btn {
  width: 45%;
  font-size: 30rpx;
  border-radius: 10rpx;
}

.modal-btn.cancel {
  background: #f1f1f1;
  color: #666;
}

.modal-btn.confirm {
  background: #007AFF;
  color: #fff;
}
